{
  "name": "FigSuite — Forecasting Terminal",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {"3000": {"label": "FigSuite web", "onAutoForward": "openPreview"}},
  "postCreateCommand": "npm install && npm test",
  "customizations": {
    "vscode": {"extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"]}
  }
}
